{
  "name": "apiwright",
  "version": "0.1.0",
  "description": "Self-hosted, declarative API testing framework. Author endpoints in JSON or import from Postman/OpenAPI; APIWright auto-generates and runs a comprehensive test catalog covering HTTP semantics, schema validation, auth boundaries, input validation, and database state verification.",
  "type": "module",
  "main": "./dist/cli/entry.js",
  "bin": {
    "apiwright": "./dist/cli/entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "V1_BUILD_SPEC.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backcompat": "vitest run --config tests/backcompat/vitest.config.ts",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "dupes": "jscpd src",
    "record-fixtures": "tsx tests/fixtures/record-fixtures.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@playwright/test": "^1.48.0",
    "ajv": "^8.17.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "date-fns": "^4.0.0",
    "dotenv": "^16.4.0",
    "js-yaml": "^4.1.0",
    "mongodb": "^6.10.0",
    "mysql2": "^3.11.0",
    "neo4j-driver": "^5.25.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postman-collection": "^5.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "@types/postman-collection": "^3.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.0.0",
    "gitleaks": "^1.0.0",
    "husky": "^8.0.3",
    "jscpd": "^4.0.5",
    "msw": "^2.6.0",
    "prettier": "^3.3.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHANGE-ME/apiwright.git"
  },
  "homepage": "https://github.com/CHANGE-ME/apiwright#readme",
  "bugs": {
    "url": "https://github.com/CHANGE-ME/apiwright/issues"
  },
  "author": "CHANGE-ME",
  "keywords": [
    "api-testing",
    "test-automation",
    "postman",
    "openapi",
    "schema-validation",
    "playwright",
    "typescript",
    "database-verification",
    "ci-cd"
  ],
  "overrides": {
    "lodash": ">=4.17.24"
  }
}
