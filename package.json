{
  "name": "apiwright",
  "version": "1.0.2",
  "private": false,
  "description": "Self-hosted, declarative API testing framework. Author endpoints in JSON or import from Postman/OpenAPI; APIWright auto-generates and runs a comprehensive test catalog covering HTTP semantics, schema validation, auth boundaries, input validation, and database state verification.",
  "type": "module",
  "main": "./dist/cli/entry.js",
  "types": "./dist/cli/entry.d.ts",
  "bin": {
    "apiwright": "./dist/cli/entry.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist node_modules/.cache/tsbuildinfo",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real-db": "vitest run tests/integration/db/real-driver",
    "test:backcompat": "vitest run --config tests/backcompat/vitest.config.ts",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "dupes": "jscpd src",
    "record-fixtures": "tsx tests/fixtures/record-fixtures.ts",
    "prepare": "node scripts/prepare-husky.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "ajv": "^8.17.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "dotenv": "^16.4.0",
    "js-yaml": "^4.3.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3"
  },
  "optionalDependencies": {
    "mongodb": "^6.10.0",
    "mysql2": "^3.22.5",
    "neo4j-driver": "^5.25.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.2",
    "husky": "^8.0.3",
    "jscpd": "^4.2.5",
    "msw": "^2.6.0",
    "prettier": "^3.3.0",
    "rimraf": "6.1.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.6"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anshulgupta1791/apiwright.git"
  },
  "homepage": "https://github.com/anshulgupta1791/apiwright#readme",
  "bugs": {
    "url": "https://github.com/anshulgupta1791/apiwright/issues"
  },
  "author": "Anshul Gupta",
  "keywords": [
    "api-testing",
    "test-automation",
    "postman",
    "openapi",
    "schema-validation",
    "typescript",
    "database-verification",
    "ci-cd"
  ],
  "overrides": {
    "lodash": ">=4.17.24",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1"
  }
}
