{
  "info": {
    "_postman_id": "apiwright-e2e-sample-collection",
    "name": "APIWright E2E Sample Collection",
    "description": "Minimal valid Postman v2.1 collection used by Checkpoint H to verify the `apiwright import postman` flow end-to-end. Contains three requests under a single folder so the import covers happy-path collection + folder + request shapes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "httpbin",
      "item": [
        {
          "name": "Get headers",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Test-Tag", "value": "apiwright-e2e" }],
            "url": {
              "raw": "https://httpbin.org/headers",
              "protocol": "https",
              "host": ["httpbin", "org"],
              "path": ["headers"]
            }
          }
        },
        {
          "name": "Post body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "https://httpbin.org/post",
              "protocol": "https",
              "host": ["httpbin", "org"],
              "path": ["post"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hello\": \"world\"}"
            }
          }
        },
        {
          "name": "Get status 200",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://httpbin.org/status/200",
              "protocol": "https",
              "host": ["httpbin", "org"],
              "path": ["status", "200"]
            }
          }
        }
      ]
    }
  ],
  "variable": []
}
