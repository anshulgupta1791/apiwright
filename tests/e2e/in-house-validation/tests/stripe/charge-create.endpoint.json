{
  "id": "stripe.charge_create",
  "name": "POST /v1/charges — write with strict server-side body validation",
  "method": "POST",
  "url": "${env.base_url}/v1/charges",
  "tags": ["stripe", "write", "validation"],
  "markers": ["regression"],
  "prod_safe": false,
  "auth_strategy": "stripe_test",
  "request": {
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body_schema": {
      "type": "object",
      "required": ["amount", "currency", "source"],
      "properties": {
        "amount":   { "type": "integer", "minimum": 50, "maximum": 99999999 },
        "currency": { "type": "string", "enum": ["usd", "eur", "gbp"] },
        "source":   { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 256 }
      }
    },
    "body_example": {
      "amount": 2000,
      "currency": "usd",
      "source": "tok_visa",
      "description": "apiwright-e2e regression run"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 8000,
    "schema": {
      "type": "object",
      "required": ["id", "object", "amount", "currency", "status"],
      "properties": {
        "id":       { "type": "string" },
        "object":   { "type": "string", "const": "charge" },
        "amount":   { "type": "integer" },
        "currency": { "type": "string" },
        "status":   { "type": "string" }
      }
    }
  },
  "assertions": [
    "response.body.amount equals 2000",
    "response.body.currency equals usd",
    "response.body.status equals succeeded"
  ]
}
