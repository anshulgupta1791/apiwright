{
  "id": "httpbin.headers_echo",
  "name": "GET /headers — request header echo",
  "method": "GET",
  "url": "${env.base_url}/headers",
  "tags": ["httpbin", "read", "headers"],
  "markers": ["smoke", "regression"],
  "prod_safe": true,
  "request": {
    "headers": {
      "X-Apiwright-Test": "checkpoint-a"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 3000,
    "schema": {
      "type": "object",
      "required": ["headers"],
      "properties": {
        "headers": { "type": "object" }
      }
    }
  },
  "assertions": [
    "response.body.headers.X-Apiwright-Test equals checkpoint-a"
  ]
}
