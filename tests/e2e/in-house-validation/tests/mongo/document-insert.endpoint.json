{
  "id": "mongo.document_insert",
  "name": "POST /action/insertOne — write to Atlas + verify via Mongo driver",
  "method": "POST",
  "url": "${env.base_url}/action/insertOne",
  "tags": ["mongo", "write", "db_verify"],
  "markers": ["regression"],
  "prod_safe": false,
  "auth_strategy": "mongo_data_api",
  "request": {
    "headers": {
      "Content-Type": "application/json"
    },
    "body_schema": {
      "type": "object",
      "required": ["dataSource", "database", "collection", "document"],
      "properties": {
        "dataSource": { "type": "string" },
        "database":   { "type": "string" },
        "collection": { "type": "string" },
        "document":   { "type": "object" }
      }
    },
    "body_example": {
      "dataSource": "Cluster0",
      "database": "apiwright_e2e",
      "collection": "documents",
      "document": {
        "test_id": "apiwright-e2e-mongo-001",
        "kind": "regression",
        "created_at": "2026-05-21T12:00:00Z"
      }
    }
  },
  "response": {
    "expected_status": 201,
    "sla_ms": 8000,
    "schema": {
      "type": "object",
      "required": ["insertedId"],
      "properties": {
        "insertedId": { "type": "string" }
      }
    }
  },
  "db_verify": [
    {
      "connection": "primary_mongo",
      "query_id": "inserted_doc",
      "query": "documents.findOne({ test_id: 'apiwright-e2e-mongo-001' })",
      "expect": "match",
      "fields": {
        "test_id": "apiwright-e2e-mongo-001",
        "kind": "regression"
      }
    }
  ],
  "cleanup": {
    "connection": "primary_mongo",
    "query": "documents.deleteMany({ test_id: 'apiwright-e2e-mongo-001' })"
  }
}
