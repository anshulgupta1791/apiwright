{
  "id": "github_pat.issue_create",
  "name": "POST /repos/{repo}/issues — chained write (issue.number used by comment endpoint)",
  "method": "POST",
  "url": "${env.base_url}/repos/${env.test_repo}/issues",
  "tags": ["github", "auth", "write", "chain"],
  "markers": ["regression"],
  "prod_safe": false,
  "auth_strategy": "github_pat",
  "request": {
    "headers": {
      "Accept": "application/vnd.github+json",
      "Content-Type": "application/json",
      "User-Agent": "apiwright-e2e"
    },
    "body_schema": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "body": { "type": "string", "maxLength": 65536 }
      }
    },
    "body_example": {
      "title": "apiwright-e2e-<runid> — issue created by the in-house E2E suite",
      "body": "Auto-generated. Safe to delete. ${env.test_repo}"
    }
  },
  "response": {
    "expected_status": 201,
    "sla_ms": 8000,
    "schema": {
      "type": "object",
      "required": ["id", "number", "title", "state", "url"],
      "properties": {
        "id": { "type": "integer" },
        "number": { "type": "integer" },
        "title": { "type": "string" },
        "state": { "type": "string" },
        "url": { "type": "string" }
      }
    }
  },
  "assertions": [
    "response.body.state equals open",
    "response.body.title equals request.body.title"
  ]
}
