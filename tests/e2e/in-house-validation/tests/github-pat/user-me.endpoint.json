{
  "id": "github_pat.user_me",
  "name": "GET /user — authenticated user via static_token",
  "method": "GET",
  "url": "${env.base_url}/user",
  "tags": ["github", "auth", "static_token"],
  "markers": ["smoke", "regression"],
  "prod_safe": true,
  "auth_strategy": "github_pat",
  "request": {
    "headers": {
      "Accept": "application/vnd.github+json",
      "User-Agent": "apiwright-e2e"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 5000,
    "schema": {
      "type": "object",
      "required": ["login", "id", "type"],
      "properties": {
        "login": { "type": "string" },
        "id": { "type": "integer" },
        "type": { "type": "string" }
      }
    }
  }
}
