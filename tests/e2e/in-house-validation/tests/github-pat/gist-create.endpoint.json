{
  "id": "github_pat.gist_create",
  "name": "POST /gists — create gist (auth + body schema)",
  "method": "POST",
  "url": "${env.base_url}/gists",
  "tags": ["github", "auth", "write", "gist"],
  "markers": ["regression"],
  "prod_safe": false,
  "auth_strategy": "github_pat",
  "request": {
    "headers": {
      "Accept": "application/vnd.github+json",
      "Content-Type": "application/json",
      "User-Agent": "apiwright-e2e"
    },
    "body_schema": {
      "type": "object",
      "required": ["description", "public", "files"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 256 },
        "public": { "type": "boolean" },
        "files": { "type": "object" }
      }
    },
    "body_example": {
      "description": "apiwright-e2e-<runid> — gist created by the in-house E2E suite",
      "public": false,
      "files": {
        "apiwright-e2e.txt": {
          "content": "Generated by apiwright in-house E2E regression suite. Safe to delete."
        }
      }
    }
  },
  "response": {
    "expected_status": 201,
    "sla_ms": 8000,
    "schema": {
      "type": "object",
      "required": ["id", "html_url", "files", "public"],
      "properties": {
        "id": { "type": "string" },
        "html_url": { "type": "string" },
        "files": { "type": "object" },
        "public": { "type": "boolean" }
      }
    }
  },
  "assertions": [
    "response.body.public equals false"
  ]
}
