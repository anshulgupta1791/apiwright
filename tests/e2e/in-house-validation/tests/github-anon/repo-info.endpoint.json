{
  "id": "github.repo_info",
  "name": "GET /repos/octocat/Hello-World — public repo metadata",
  "method": "GET",
  "url": "${env.base_url}/repos/octocat/Hello-World",
  "tags": ["github", "read", "repos", "critical-path"],
  "markers": ["smoke", "regression"],
  "prod_safe": true,
  "request": {
    "headers": {
      "Accept": "application/vnd.github+json",
      "User-Agent": "apiwright-e2e"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 5000,
    "schema": {
      "type": "object",
      "required": ["id", "name", "full_name", "owner", "private"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "full_name": { "type": "string" },
        "owner": { "type": "object" },
        "private": { "type": "boolean" }
      }
    }
  },
  "assertions": [
    "response.body.name equals Hello-World",
    "response.body.full_name equals octocat/Hello-World",
    "response.body.private equals false"
  ]
}
