{
  "id": "github.user_profile",
  "name": "GET /users/octocat — public user profile (anonymous)",
  "method": "GET",
  "url": "${env.base_url}/users/octocat",
  "tags": ["github", "read", "smoke"],
  "markers": ["smoke", "regression"],
  "prod_safe": true,
  "request": {
    "headers": {
      "Accept": "application/vnd.github+json",
      "User-Agent": "apiwright-e2e"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 5000,
    "schema": {
      "type": "object",
      "required": ["login", "id", "type", "site_admin"],
      "properties": {
        "login": { "type": "string" },
        "id": { "type": "integer" },
        "type": { "type": "string" },
        "site_admin": { "type": "boolean" },
        "name": { "type": ["string", "null"] }
      }
    }
  },
  "assertions": [
    "response.body.login equals octocat",
    "response.body.type equals User",
    "response.body.id equals 583231"
  ]
}
