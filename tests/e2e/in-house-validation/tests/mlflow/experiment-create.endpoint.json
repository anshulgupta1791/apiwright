{
  "id": "mlflow.experiment_create",
  "name": "POST /api/2.0/mlflow/experiments/create — write + db_verify MySQL",
  "method": "POST",
  "url": "${env.base_url}/api/2.0/mlflow/experiments/create",
  "tags": ["mlflow", "write", "db_verify", "mysql"],
  "markers": ["regression"],
  "prod_safe": false,
  "request": {
    "headers": { "Content-Type": "application/json" },
    "body_schema": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "body_example": {
      "name": "apiwright-e2e-experiment-001"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 8000,
    "schema": {
      "type": "object",
      "required": ["experiment_id"],
      "properties": {
        "experiment_id": { "type": "string" }
      }
    }
  },
  "db_verify": [
    {
      "connection": "primary_mysql",
      "query_id": "experiment_persisted",
      "query": "SELECT name FROM experiments WHERE name = 'apiwright-e2e-experiment-001'",
      "expect": "match",
      "fields": {
        "name": "apiwright-e2e-experiment-001"
      }
    }
  ],
  "cleanup": {
    "connection": "primary_mysql",
    "query": "DELETE FROM experiments WHERE name = 'apiwright-e2e-experiment-001'"
  }
}
