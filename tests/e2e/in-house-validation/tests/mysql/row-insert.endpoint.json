{
  "id": "mysql.row_insert",
  "name": "PlanetScale query API insert + verify via MySQL driver",
  "method": "POST",
  "url": "${env.base_url}/psdb.v1alpha1.Database/Execute",
  "tags": ["mysql", "write", "db_verify"],
  "markers": ["regression"],
  "prod_safe": false,
  "request": {
    "headers": {
      "Authorization": "Basic ${secret.APIWRIGHT_E2E_MYSQL_BASIC}",
      "Content-Type": "application/json"
    },
    "body_schema": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string" }
      }
    },
    "body_example": {
      "query": "INSERT INTO apiwright_e2e (test_id, kind, created_at) VALUES ('apiwright-e2e-mysql-001', 'regression', NOW())"
    }
  },
  "response": {
    "expected_status": 200,
    "sla_ms": 8000
  },
  "db_verify": [
    {
      "connection": "primary_mysql",
      "query_id": "inserted_row",
      "query": "SELECT test_id, kind FROM apiwright_e2e WHERE test_id = 'apiwright-e2e-mysql-001'",
      "expect": "match",
      "fields": {
        "test_id": "apiwright-e2e-mysql-001",
        "kind": "regression"
      }
    }
  ],
  "cleanup": {
    "connection": "primary_mysql",
    "query": "DELETE FROM apiwright_e2e WHERE test_id = 'apiwright-e2e-mysql-001'"
  }
}
