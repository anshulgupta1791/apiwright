{
  "id": "jsonplaceholder.post_create",
  "name": "POST /posts — write with body schema + templating",
  "method": "POST",
  "url": "${env.base_url}/posts",
  "tags": ["jsonplaceholder", "write", "templating"],
  "markers": ["regression"],
  "prod_safe": false,
  "request": {
    "headers": { "Content-Type": "application/json" },
    "body_schema": {
      "type": "object",
      "required": ["title", "body", "userId"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body":  { "type": "string", "minLength": 1, "maxLength": 5000 },
        "userId": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "body_example": {
      "title": "apiwright-e2e-test-title",
      "body": "Generated by the in-house E2E regression suite.",
      "userId": 1
    }
  },
  "response": {
    "expected_status": 201,
    "sla_ms": 5000,
    "schema": {
      "type": "object",
      "required": ["id", "title", "body", "userId"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "userId": { "type": "integer" }
      }
    }
  },
  "assertions": [
    "response.body.title equals request.body.title",
    "response.body.userId equals request.body.userId"
  ]
}
